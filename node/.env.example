# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Logging: fatal | error | warn | info | debug | trace | silent
# Default: info (silent under NODE_ENV=test). Development prints readable logs,
# production prints one JSON object per line on stdout.
# Leave unset to use the defaults; setting it here also un-silences npm test.
# LOG_LEVEL=info

# Database connection
# NODE_ENV (development | test | production) picks the config in knexfile.js;
# set it in the shell or hosting platform, not here. Defaults to development.
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=psp_dev
DB_USER=postgres
DB_PASSWORD=change-me

# Database used when NODE_ENV=test (npm test). Must already exist; tests never touch DB_NAME.
DB_TEST_NAME=psp_test

# Connection pool (one shared pool per API process; min is fixed at 0)
# Keep DB_POOL_MAX x number of API processes below Postgres max_connections.
DB_POOL_MAX=10
# Milliseconds a query waits for a free pool connection before failing.
DB_ACQUIRE_TIMEOUT_MS=10000
# Milliseconds an unused connection stays open before the pool closes it.
DB_IDLE_TIMEOUT_MS=30000

# Postgres cancels any single statement running longer than this (milliseconds).
# Long migrations may need a higher value when run.
DB_STATEMENT_TIMEOUT_MS=30000

# SSL (only read when NODE_ENV=production)
DB_SSL=false
# Keep true in production; set false only for a server with a self-signed cert you trust.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional path to the CA certificate (PEM) your database provider gives you.
DB_SSL_CA_FILE=
