# Copy this file to .env for local development. Never commit .env.
#
# Everything in a VITE_ variable is bundled into public JavaScript that anyone
# can read: never put secrets, keys or passwords here.

# Base URL of the PSP Express API (node/), without a trailing slash.
# Must match an origin the API allows: the API's CLIENT_ORIGIN must be this app's URL.
# Leave empty when the API is served from the same origin as this app
# (for example, both behind one reverse proxy); requests then go to /api/... directly.
VITE_API_BASE_URL=http://localhost:5000
